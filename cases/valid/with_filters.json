{
  "mql_version": "1.1",
  "metrics": [
    {
      "name": "gmv"
    }
  ],
  "filters": [
    {
      "field": "region",
      "operator": "eq",
      "value": "华东"
    },
    {
      "field": "store_type",
      "operator": "in",
      "value": [
